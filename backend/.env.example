# 大模型 API 密钥配置 (仅在后端安全存储，绝不泄露给浏览器)
# 支持官方 OpenAI、DeepSeek、Kimi、智谱、Ollama 等任何兼容接口

# 1. 填入你的真实 API 密钥 (若留空，系统会自动启用高质量高拟真的本地流式演示)
OPENAI_API_KEY=

# 2. 接口 Base URL (默认以便宜好用的 DeepSeek 为例，也可换成 https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 3. 模型名称 (例如 deepseek-chat 或 gpt-4o-mini)
MODEL_NAME=deepseek-chat
